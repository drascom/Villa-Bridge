<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <WebView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/loading_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp"
        android:text="@string/loading_dashboard"
        android:textColor="#17382D"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/runtime_stopped"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/ic_villa_bridge"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/runtime_stopped_title"
            android:textColor="#17382D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:text="@string/runtime_stopped_message"
            android:textColor="#64736C"
            android:textSize="16sp" />

        <Button
            android:id="@+id/start_runtime"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/runtime_start"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
