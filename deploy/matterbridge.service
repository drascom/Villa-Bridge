[Unit]
Description=Matterbridge for Villa Bridge
After=network-online.target mosquitto.service villa-bridge.service
Wants=network-online.target
Requires=mosquitto.service villa-bridge.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=HOME=/var/lib/matterbridge
Environment=PATH=/var/lib/matterbridge/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment="NODE_OPTIONS=--import=/usr/local/lib/matterbridge-name-alias-hook.mjs"
Environment="MATTERBRIDGE_NAME_ALIASES=/var/lib/matterbridge/.matterbridge/matterbridge-name-aliases.json"
ExecStart=/var/lib/matterbridge/.npm-global/bin/matterbridge --service --bridge --novirtual
WorkingDirectory=/var/lib/matterbridge/Matterbridge
StandardOutput=journal
StandardError=journal
SyslogIdentifier=matterbridge
Restart=always
RestartSec=5
TimeoutStopSec=60
User=matterbridge
Group=matterbridge
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/matterbridge

[Install]
WantedBy=multi-user.target
