[Unit]
Description=Villa Bridge smart home gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/villa-bridge
Environment=NODE_ENV=production
Environment=VILLA_BRIDGE_MODE=direct
Environment=VILLA_BRIDGE_NODE_ROLE=server
Environment=VILLA_BRIDGE_CONFIG=/opt/villa-bridge/config/default.yaml
ExecStart=/usr/bin/node /opt/villa-bridge/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/villa-bridge /opt/zigbee2mqtt/data /var/lib/matterbridge/.matterbridge

[Install]
WantedBy=multi-user.target
