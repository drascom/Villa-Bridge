[Unit]
Description=Villa Bridge smart-home runtime
Documentation=https://github.com/drascom/Villa-Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=villa-bridge
Group=villa-bridge
WorkingDirectory=/opt/villa-bridge
Environment=VILLA_BRIDGE_NODE_ROLE=server
ExecStart=/usr/local/bin/node /opt/villa-bridge/apps/runtime/main.cjs --platform=linux --core-host=0.0.0.0 --core-entrypoint=/opt/villa-bridge/dist/index.js --mqtt-host=0.0.0.0 --data-dir=/var/lib/villa-bridge
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/villa-bridge

[Install]
WantedBy=multi-user.target
